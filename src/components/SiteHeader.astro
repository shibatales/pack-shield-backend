---
const themes = [
  ["glass-aqua", "Glass Aqua"],
  ["glass-ember", "Glass Ember"],
  ["glass-solar", "Glass Solar"],
  ["glass-sky", "Glass Sky"],
  ["glass-moss", "Glass Moss"],
  ["glass-violet", "Glass Violet"],
  ["glass-rose", "Glass Rose"]
];
---

<header class="site-shell">
  <nav class="site-nav" aria-label="Primary">
    <a class="brand-link" href="/">
      <img class="brand-icon" src="/app-icon.png" alt="" width="34" height="34" />
      <span>
        <span class="brand-title brand-title-desktop">Pack Shield</span>
        <span class="brand-title brand-title-mobile">Pack Shield: Recovery Buddy</span>
        <span class="brand-subtitle">Recovery Buddy</span>
      </span>
    </a>
    <button class="menu-toggle" type="button" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false" data-menu-toggle>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path class="menu-lines" d="M4 7h16M4 12h16M4 17h16"></path>
        <path class="menu-x" d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
    <div class="nav-actions" id="mobile-menu" data-menu-panel>
      <div class="nav-links">
        <a href="/support" data-nav-link>Support</a>
        <a href="/releases" data-nav-link>Releases</a>
        <a href="/privacy" data-nav-link>Privacy</a>
        <a href="/terms" data-nav-link>Terms</a>
        <a href="/sms-consent" data-nav-link>SMS</a>
      </div>
      <a class="nav-download" href="https://apps.apple.com/app/id6809620104">Download</a>
      <label class="theme-control">
        <span>Theme</span>
        <select data-theme-select aria-label="Color theme">
          {themes.map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </label>
    </div>
  </nav>
</header>
