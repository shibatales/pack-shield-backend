---
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  footerKind?: "marketing" | "contact";
  stickyCta?: boolean;
  socialImage?: string;
}

const {
  title,
  description = "Pack Shield: Recovery Buddy helps adults put a practical pause between an urge and a choice with pledges, timers, support shortcuts, Shield friction, and Shibit care.",
  bodyClass = "",
  footerKind = "contact",
  stickyCta = false,
  socialImage = "/app-icon.png"
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://packshield.app").toString();
const socialImageUrl = new URL(socialImage, Astro.site ?? "https://packshield.app").toString();

const assetVersion = "20260908-design33";
---

<!doctype html>
<html lang="en" data-theme="glass-aqua">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="Pack Shield" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("packshield.web.theme.v1");
          if (theme) document.documentElement.dataset.theme = theme;
        } catch {}
      })();
    </script>
    <link rel="icon" href="/app-icon.png" />
    <link rel="apple-touch-icon" href="/app-icon.png" />
    <link rel="stylesheet" href={`/theme.css?v=${assetVersion}`} />
    <script defer src={`/theme.js?v=${assetVersion}`}></script>
  </head>
  <body class:list={[bodyClass]}>
    <div class="fixed-gradient-backdrop" aria-hidden="true"></div>
    <div class="fixed-pattern-backdrop" aria-hidden="true">
      <svg width="100%" height="100%" focusable="false">
        <defs>
          <pattern id="ground-glide-tiles" width="28" height="28" patternUnits="userSpaceOnUse">
            <path class="tile-line vertical" d="M0 0V28" />
            <path class="tile-line horizontal" d="M0 0H28" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#ground-glide-tiles)" />
      </svg>
    </div>
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteHeader />
    <slot />
    <SiteFooter kind={footerKind} />
    {stickyCta && <a class="mobile-sticky-cta" href="https://apps.apple.com/app/id6809620104">Download Pack Shield</a>}
  </body>
</html>
