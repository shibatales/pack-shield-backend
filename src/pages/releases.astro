---
import SiteLayout from "../components/SiteLayout.astro";

const releases = [
  {
    id: "version-1-3",
    version: "Version 1.3",
    date: "Coming soon",
    title: "Gratitude, meditation, and fuller Shibit progression",
    intro:
      "Version 1.3 expands the recovery loop after Version 1.2 with daily gratitude, meditation, richer reminders and achievements, fursuit clarity, deeper Shibit XP/stat systems, and a cleaner Care-first Den.",
    highlights: [
      {
        title: "Daily gratitude",
        detail:
          "Create a daily gratitude list, count it toward Daily Flow, save it with your Shibit, and export a space-styled share card."
      },
      {
        title: "Meditation timer",
        detail:
          "Meditation is now its own timer-backed daily action with Shibit memories, Daily XP, reminders, and achievement progress."
      },
      {
        title: "Expanded Daily Flow",
        detail:
          "Daily Flow now includes Pledge, Gratitude, Meditation, Shibit care, Focus, and Review, with gratitude and meditation routed from reminders."
      },
      {
        title: "Need Help Now additions",
        detail:
          "Need Help Now now includes Gratitude and Meditation alongside Rescue, Talk, Meetings, Shield, Focus, Plan, and Restart."
      },
      {
        title: "Fursuits and collection clarity",
        detail:
          "Shibit skins are now presented as fursuits, with animated preview sheets, flavor text, owned/equipped states, fursuit bonuses, and clearer suite bundle styling."
      },
      {
        title: "Shibit XP and stat growth",
        detail:
          "Fursuit XP bonuses apply to rewards, inactive Shibits receive 50% passive XP, and Shibit stat growth now explains how base stats influence HP, HUN, HYG, and HOM."
      },
      {
        title: "Care-first Den",
        detail:
          "The Den now opens to Care first, then Games, Fursuits, and Suites. Active ailments, treatment actions, pulsing care prompts, and guide-sheet routing are easier to use."
      },
      {
        title: "Suite and room polish",
        detail:
          "Suite room previews, owned/equipped labels, classic fursuit thumbnails, and room selection persistence were cleaned up to reduce visual jumping and clearer ownership states."
      },
      {
        title: "Home cleanup",
        detail:
          "Home removes the old Status section, restores the sobriety-clock plus button, improves stat breakdown explanations, and opens the Badge Wall directly from tapped milestone badges."
      }
    ],
    smallerFixes: [
      "Ailment pills and treatment pills were normalized across Home, The Den, and the ailments sheet.",
      "Treatment actions now confirm from the ailments sheet and can handle multiple active ailments treated by the same action.",
      "The mood badge can route into The Den's Care tab.",
      "Snackbar XP copy reflects fursuit XP bonuses where applicable.",
      "Release announcements refresh when the app returns active so new release cards are easier to surface."
    ]
  },
  {
    id: "version-1-2",
    version: "Version 1.2",
    date: "September 14, 2026",
    title: "Daily Flow, Shield handoffs, and clearer action polish",
    intro:
      "Version 1.2 tightens the daily recovery loop that shipped through build 43: smarter Shield handoffs, clearer Shibit progression, Daily Flow with Daily XP, editable stake language, and more consistent action polish across Home, The Den, Settings, and release guidance.",
    highlights: [
      {
        title: "Smarter Shield handoffs",
        detail:
          "Screen Time shield actions now route into the Shield tab with the blocked app or site context preserved, so Open Shield, Contact Handler, and emergency paths can present a better next step."
      },
      {
        title: "Expanded stat guides",
        detail:
          "The Den now explains Health, Hunger, Hygiene, Home, Strength, Hope, Wisdom, Serenity, and Courage with clearer descriptions and more useful guide-sheet context."
      },
      {
        title: "SER and COU action pools",
        detail:
          "Care and play choices now surface how Serenity and Courage affect hourly recovery action capacity, making resource planning easier to understand."
      },
      {
        title: "WIS point allocation",
        detail:
          "Wisdom now has a clearer role in point allocation for care and play capacity, tying long-term Shibit growth back to practical daily choices."
      },
      {
        title: "Perk previews",
        detail:
          "Suit, skin, base, and room details now call out their perks so collection choices feel less mysterious before players equip or purchase them."
      },
      {
        title: "Suite polish",
        detail:
          "Suite bundle previews and room styling were tightened so store and Den choices read more clearly across themes."
      },
      {
        title: "Daily Flow and Daily XP",
        detail:
          "Daily Flow on Home now tracks Daily XP for Pledge, Shibit care, Focus, and Review. Incomplete actions stay left, completed actions move right, and expanded cards show subdued XP until completion turns them green."
      },
      {
        title: "Swipeable compact flow",
        detail:
          "The collapsed Daily Flow row now uses a clipped swipe tray so action icons can move horizontally without overlapping the Daily Flow title or accordion control."
      },
      {
        title: "Rescue as support status",
        detail:
          "Rescue moved out of the required daily checklist and into Support Status, where it can read Ready, Active, or Done without penalizing days when no urge needs rescuing."
      },
      {
        title: "Editable primary stake",
        detail:
          "The protected default reason is now My life, and it can be edited without becoming deletable. Clearing it restores the safe default."
      },
      {
        title: "Sobriety clock management",
        detail:
          "The main clock stays on Home, while add, show-on-Home, edit, reset, and delete controls now live under Recovery support in Settings."
      }
    ],
    smallerFixes: [
      "Emergency and handler flows now use typed Shield actions instead of loose string matching.",
      "Per-base Shibit care state is preserved more consistently when switching avatars.",
      "Old Myself stake defaults migrate cleanly into the new My life primary stake reason.",
      "Guide sheets received clearer spacing, badges, and pagination for smaller screens.",
      "Action colors were separated so Feed, Restart, Shibit, Care, Rescue, Soothe, Meetings, Water, Medicine, Shield, Support, Reflect, Plan, Den, and Focus are easier to tell apart wherever they appear.",
      "The hold-to-pledge button now has a richer gradient treatment while preserving the same hold interaction.",
      "Release announcements can stay short in-app while linking here for the full detail list."
    ]
  },
  {
    id: "version-1-1",
    version: "Version 1.1",
    date: "September 12, 2026",
    title: "Mood, ailments, themes, and timer alerts",
    intro:
      "Version 1.1 pulled together clearer Home language, richer Shibit care systems, refreshed Den guidance, stronger Focus timer alerts, and visual cleanup across themes and suites.",
    highlights: [
      {
        title: "Mood and ailments",
        detail:
          "The Den now has dedicated Mood and Ailments guide pages, active ailment badges, treatment badges, clearer untreated-effect copy, and a mood pill beside Shibit level."
      },
      {
        title: "Home and recovery flow",
        detail:
          "Home now uses clearer sobriety clock wording, improved recovery action colors, rotating stake reasons, compact ailment chips, and a more direct Den shortcut."
      },
      {
        title: "Shibit stats and care",
        detail:
          "Stats now better explain your recovery buddy, the Shibit, including Health, Hunger, Hygiene, Home, Strength, Hope, Wisdom, Serenity, and Courage."
      },
      {
        title: "Themes and suites",
        detail:
          "Theme previews and suite rooms were tuned so color overlays feel present without flattening the artwork, especially on synthwave and suit suite rooms."
      },
      {
        title: "Focus timers",
        detail:
          "Timer completion now uses a stronger in-app alarm with haptics, while local notifications stay scheduled for background or locked-screen timer endings."
      },
      {
        title: "Shibit collection refresh",
        detail:
          "Several Shibit bases and skins were refreshed, renamed, or reorganized so the collection lines up better with the current pack direction."
      }
    ],
    smallerFixes: [
      "History and stake displays were tightened up for easier scanning.",
      "Settings copy now consistently refers to sobriety clocks instead of timers where appropriate.",
      "Game and care resource language now uses Courage and Serenity more consistently.",
      "The App Tour badge and dark-theme contrast received readability polish.",
      "Stats and guide sheets received spacing, pagination, and badge color refinements."
    ]
  }
];
---

<SiteLayout
  title="Pack Shield Release Log"
  description="See what changed in Pack Shield: Recovery Buddy releases, including Version 1.3 gratitude, meditation, fursuits, and Shibit progression updates; Version 1.2 Shield and Daily Flow polish; and Version 1.1 mood, ailments, themes, Shibit care, and timer alert updates."
>
  <main id="content" class="site-shell release-page">
    <section class="release-hero glass-panel" aria-labelledby="release-title">
      <p class="eyebrow">Release log</p>
      <h1 id="release-title">What changed in Pack Shield</h1>
      <p>
        A plain-language history of important app updates. In-app announcements link here when a release needs more detail than a small card can comfortably hold.
      </p>
    </section>

    <div class="release-list">
      {releases.map((release) => (
        <article class="release-entry glass-panel" id={release.id}>
          <div class="release-entry-header">
            <div>
              <p class="eyebrow">{release.date}</p>
              <h2>{release.title}</h2>
            </div>
            <a class="release-badge" href={`#${release.id}`} aria-label={`Permalink to ${release.version}`}>
              {release.version}
            </a>
          </div>

          <p class="release-intro">{release.intro}</p>

          <div class="release-summary-grid">
            {release.highlights.map((item) => (
              <section class="release-change-card">
                <h3>{item.title}</h3>
                <p>{item.detail}</p>
              </section>
            ))}
          </div>

          <section class="release-fixes" aria-labelledby={`${release.id}-fixes`}>
            <h3 id={`${release.id}-fixes`}>Also included</h3>
            <ul>
              {release.smallerFixes.map((fix) => <li>{fix}</li>)}
            </ul>
          </section>
        </article>
      ))}
    </div>
  </main>
</SiteLayout>
