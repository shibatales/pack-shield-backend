---
import SiteLayout from "../components/SiteLayout.astro";

const releases = [
  {
    id: "version-1-2",
    version: "Version 1.2",
    date: "September 14, 2026",
    title: "Daily Flow, Shibit progression, and stronger recovery rituals",
    intro:
      "Version 1.2 expands Pack Shield into a fuller daily recovery loop: Daily Flow now includes gratitude, meditation, pledge, care, focus, and review; Need Help Now has more grounding options; The Den, fursuits, suites, ailments, and Shibit stat growth are clearer; and Shield/support flows are easier to trust in the moment.",
    highlights: [
      {
        title: "Daily Flow and Daily XP",
        detail:
          "Daily Flow now tracks Pledge, Gratitude, Meditation, Shibit care, Focus, and Review for 30 Daily XP each. Incomplete actions stay left, completed actions move right, and the collapsed row remains swipeable."
      },
      {
        title: "Gratitude lists and share cards",
        detail:
          "You can create a daily gratitude list, count it toward Daily Flow progress, schedule a gratitude reminder, and export a space-styled share image with your Shibit."
      },
      {
        title: "Meditation timer",
        detail:
          "Meditation is now its own daily action with reminders, achievements, and a timer that records quiet reset sessions."
      },
      {
        title: "Need Help Now refresh",
        detail:
          "Need Help Now adds Gratitude and Meditation alongside Rescue, Talk, Meetings, Shield, Focus, Plan, and Restart so more support tools are reachable in one place."
      },
      {
        title: "Shibit progression",
        detail:
          "Fursuit bonuses, XP boosts, 50% inactive Shibit XP, and stat-growth breakdowns make Shibit progression easier to understand and tune."
      },
      {
        title: "The Den care pass",
        detail:
          "The Den now opens with Care first and presents active ailments, treatment actions, suite rooms, fursuits, games, and Shibit status with cleaner pills and guide sheets."
      },
      {
        title: "Fursuits and suites",
        detail:
          "Skins are now fursuits. Fursuit and suite info sheets show bonuses, flavor text, animated previews, owned/equipped states, and clearer bundle mix styling."
      },
      {
        title: "Ailments and treatment flow",
        detail:
          "Ailment sheets and care actions now show treatment pills, confirmation before treatment from the list, active-action pulses, and easier navigation from mood or ailment badges."
      },
      {
        title: "Shield and support clarity",
        detail:
          "Screen Time shield actions route into the Shield tab with app or site context preserved, and Rescue now lives as support status rather than a required daily chore."
      },
      {
        title: "Visual and interaction polish",
        detail:
          "Action colors, pledge gradients, suite previews, stat breakdowns, home headers, reminders, and swipe rows were tightened across light and dark themes."
      }
    ],
    smallerFixes: [
      "Emergency and handler flows now use typed Shield actions instead of loose string matching.",
      "Per-base Shibit care state is preserved more consistently when switching avatars.",
      "Old Myself stake defaults migrate cleanly into the new My life primary stake reason.",
      "The protected default reason can be edited without becoming deletable, and clearing it restores the safe default.",
      "Sobriety clocks can still be added from Home while full clock management lives in Settings.",
      "Milestone badges open the Badge Wall focused on the tapped badge.",
      "The Home status section was removed after support status moved into Daily Flow.",
      "Home stat breakdown now explains each stat and renames Skin to the active fursuit.",
      "Suite room selection persists more reliably and no longer flashes through unequipped rooms.",
      "Release announcements can stay short in-app while linking here for the full detail list."
    ]
  },
  {
    id: "version-1-1",
    version: "Version 1.1",
    date: "September 12, 2026",
    title: "Mood, ailments, themes, and timer alerts",
    intro:
      "Version 1.1 pulled together clearer Home language, richer Shibit care systems, refreshed Den guidance, stronger Focus timer alerts, and visual cleanup across themes and suites.",
    highlights: [
      {
        title: "Mood and ailments",
        detail:
          "The Den now has dedicated Mood and Ailments guide pages, active ailment badges, treatment badges, clearer untreated-effect copy, and a mood pill beside Shibit level."
      },
      {
        title: "Home and recovery flow",
        detail:
          "Home now uses clearer sobriety clock wording, improved recovery action colors, rotating stake reasons, compact ailment chips, and a more direct Den shortcut."
      },
      {
        title: "Shibit stats and care",
        detail:
          "Stats now better explain your recovery buddy, the Shibit, including Health, Hunger, Hygiene, Home, Strength, Hope, Wisdom, Serenity, and Courage."
      },
      {
        title: "Themes and suites",
        detail:
          "Theme previews and suite rooms were tuned so color overlays feel present without flattening the artwork, especially on synthwave and suit suite rooms."
      },
      {
        title: "Focus timers",
        detail:
          "Timer completion now uses a stronger in-app alarm with haptics, while local notifications stay scheduled for background or locked-screen timer endings."
      },
      {
        title: "Shibit collection refresh",
        detail:
          "Several Shibit bases and skins were refreshed, renamed, or reorganized so the collection lines up better with the current pack direction."
      }
    ],
    smallerFixes: [
      "History and stake displays were tightened up for easier scanning.",
      "Settings copy now consistently refers to sobriety clocks instead of timers where appropriate.",
      "Game and care resource language now uses Courage and Serenity more consistently.",
      "The App Tour badge and dark-theme contrast received readability polish.",
      "Stats and guide sheets received spacing, pagination, and badge color refinements."
    ]
  }
];
---

<SiteLayout
  title="Pack Shield Release Log"
  description="See what changed in Pack Shield: Recovery Buddy releases, including Version 1.2 Daily Flow, gratitude, meditation, fursuit, suite, and Shibit progression updates plus Version 1.1 mood, ailments, themes, Shibit care, and timer alert updates."
>
  <main id="content" class="site-shell release-page">
    <section class="release-hero glass-panel" aria-labelledby="release-title">
      <p class="eyebrow">Release log</p>
      <h1 id="release-title">What changed in Pack Shield</h1>
      <p>
        A plain-language history of important app updates. In-app announcements link here when a release needs more detail than a small card can comfortably hold.
      </p>
    </section>

    <div class="release-list">
      {releases.map((release) => (
        <article class="release-entry glass-panel" id={release.id}>
          <div class="release-entry-header">
            <div>
              <p class="eyebrow">{release.date}</p>
              <h2>{release.title}</h2>
            </div>
            <a class="release-badge" href={`#${release.id}`} aria-label={`Permalink to ${release.version}`}>
              {release.version}
            </a>
          </div>

          <p class="release-intro">{release.intro}</p>

          <div class="release-summary-grid">
            {release.highlights.map((item) => (
              <section class="release-change-card">
                <h3>{item.title}</h3>
                <p>{item.detail}</p>
              </section>
            ))}
          </div>

          <section class="release-fixes" aria-labelledby={`${release.id}-fixes`}>
            <h3 id={`${release.id}-fixes`}>Also included</h3>
            <ul>
              {release.smallerFixes.map((fix) => <li>{fix}</li>)}
            </ul>
          </section>
        </article>
      ))}
    </div>
  </main>
</SiteLayout>
