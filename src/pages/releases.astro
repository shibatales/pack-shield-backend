---
import SiteLayout from "../components/SiteLayout.astro";

const releases = [
  {
    id: "version-1-4",
    version: "Version 1.4",
    date: "September 15, 2026",
    title: "Essentials, Pause, and calmer recovery flows",
    intro:
      "Version 1.4 reorganizes Pack Shield around the recovery tools people need fastest: Today, Rescue, Pause, Progress, and Settings in Essentials, with deeper Shield, buddy, meeting, recovery-plan, and data controls still available in All Tools.",
    highlights: [
      {
        title: "Shorter first run",
        detail:
          "Onboarding now focuses on four steps: start, choose a recovery buddy, set a sober clock, and name what you are protecting."
      },
      {
        title: "Essentials and All Tools",
        detail:
          "Essentials keeps the app calmer by centering the sober clock, Rescue, Pause timers, Progress, Settings, optional support setup, and a passive recovery buddy. All Tools keeps the deeper controls."
      },
      {
        title: "Today feels lighter",
        detail:
          "Home is now Today, with the sober clock, what you are protecting, and Rescue placed closer to the top. The extra mode switch moved into Settings."
      },
      {
        title: "Pause timer ideas",
        detail:
          "Pause now includes clickable idea pills for breathwork, prayer, quiet time, support calls, walking outside, shower resets, rest, reading, and other short recovery pauses."
      },
      {
        title: "Cleaner Rescue",
        detail:
          "Rescue now keeps the immediate action, timer, support options, and protected reason in a simpler order with less setup work during risky moments."
      },
      {
        title: "Progress without extra pressure",
        detail:
          "Progress keeps recovery milestones, badges, calendars, and activity easier to scan. Buddy memories and buddy-specific badges stay in All Tools."
      },
      {
        title: "Shield as optional friction",
        detail:
          "Shield setup now explains the Screen Time path more clearly, previews the pause flow, and treats Shield as supportive friction rather than a guarantee."
      },
      {
        title: "Settings reorganized",
        detail:
          "Settings is grouped around Recovery, Protection, Buddy, App, Account and data, Help, About, and Safety, with clearer labels for switching between Essentials and All Tools."
      }
    ],
    smallerFixes: [
      "Navigation labels now read Today, Pause, Progress, Shield, and Settings.",
      "Selected tab capsules have more breathing room around labels.",
      "The Progress calendar header has more top room.",
      "XP labels now use the clearer spaced format, such as 20 XP.",
      "Shibit wording was softened to recovery buddy, looks, rooms, Den, and care cues where it fits.",
      "Support copy now uses support person language more consistently.",
      "The Shield extension now sends people toward Pause, Rescue, support, or a limited emergency unlock with calmer wording."
    ]
  },
  {
    id: "version-1-3",
    version: "Version 1.3",
    date: "September 15, 2026",
    title: "Gratitude, meditation, and fuller Shibit progression",
    intro:
      "Version 1.3 expands the recovery loop after Version 1.2 with daily gratitude, meditation, richer reminders and achievements, alternate-look clarity, deeper Shibit XP/stat systems, and a cleaner Care-first Den.",
    highlights: [
      {
        title: "Daily gratitude",
        detail:
          "Create a daily gratitude list, count it toward Daily Flow, save it with your Shibit, and export a space-styled share card."
      },
      {
        title: "Meditation timer",
        detail:
          "Meditation is now its own timer-backed daily action with Shibit memories, Daily XP, reminders, and achievement progress."
      },
      {
        title: "Expanded Daily Flow",
        detail:
          "Daily Flow now includes Pledge, Gratitude, Meditation, Shibit care, Pause, and Review, with gratitude and meditation routed from reminders."
      },
      {
        title: "Support toolkit additions",
        detail:
          "The quick-support toolkit now includes Gratitude and Meditation alongside Rescue, Talk, Meetings, Shield, Pause, Plan, and Restart."
      },
      {
        title: "Looks and collection clarity",
        detail:
          "Shibit alternate looks now have animated preview sheets, flavor text, owned/equipped states, look bonuses, and clearer room bundle styling."
      },
      {
        title: "Shibit XP and stat growth",
        detail:
          "Look XP bonuses apply to rewards, inactive Shibits receive 50% passive XP, and Shibit stat growth now explains how base stats influence HP, HUN, HYG, and HOM."
      },
      {
        title: "Care-first Den",
        detail:
          "The Den now opens to Care first, then Games, Looks, and Rooms. Active risks, treatment actions, pulsing care prompts, and guide-sheet routing are easier to use."
      },
      {
        title: "Room polish",
        detail:
          "Room previews, owned/equipped labels, classic look thumbnails, and room selection persistence were cleaned up to reduce visual jumping and clarify ownership states."
      },
      {
        title: "Home cleanup",
        detail:
          "Home removes the old Status section, restores the sobriety-clock plus button, improves stat breakdown explanations, and opens the Badge Wall directly from tapped milestone badges."
      }
    ],
    smallerFixes: [
      "Risk pills and treatment pills were normalized across Home, The Den, and the risks sheet.",
      "Treatment actions now confirm from the risks sheet and can handle multiple active risks treated by the same action.",
      "The mood badge can route into The Den's Care tab.",
      "Snackbar XP copy reflects look XP bonuses where applicable.",
      "Release announcements refresh when the app returns active so new release cards are easier to surface."
    ]
  },
  {
    id: "version-1-2",
    version: "Version 1.2",
    date: "September 14, 2026",
    title: "Daily Flow, Shield handoffs, and clearer action polish",
    intro:
      "Version 1.2 tightens the daily recovery loop that shipped through build 43: smarter Shield handoffs, clearer Shibit progression, Daily Flow with Daily XP, editable stake language, and more consistent action polish across Home, The Den, Settings, and release guidance.",
    highlights: [
      {
        title: "Smarter Shield handoffs",
        detail:
          "Screen Time shield actions now route into the Shield tab with the blocked app or site context preserved, so Open Shield, contact support, and emergency paths can present a better next step."
      },
      {
        title: "Expanded stat guides",
        detail:
          "The Den now explains Health, Hunger, Hygiene, Home, Strength, Hope, Wisdom, Serenity, and Courage with clearer descriptions and more useful guide-sheet context."
      },
      {
        title: "SER and COU action pools",
        detail:
          "Care and play choices now surface how Serenity and Courage affect hourly recovery action capacity, making resource planning easier to understand."
      },
      {
        title: "WIS point allocation",
        detail:
          "Wisdom now has a clearer role in point allocation for care and play capacity, tying long-term Shibit growth back to practical daily choices."
      },
      {
        title: "Perk previews",
        detail:
          "Room bundle, look, base, and room details now call out their perks so collection choices feel less mysterious before players equip or purchase them."
      },
      {
        title: "Suite polish",
        detail:
          "Suite bundle previews and room styling were tightened so store and Den choices read more clearly across themes."
      },
      {
        title: "Daily Flow and Daily XP",
        detail:
          "Daily Flow on Home now tracks Daily XP for Pledge, Shibit care, Pause, and Review. Incomplete actions stay left, completed actions move right, and expanded cards show subdued XP until completion turns them green."
      },
      {
        title: "Swipeable compact flow",
        detail:
          "The collapsed Daily Flow row now uses a clipped swipe tray so action icons can move horizontally without overlapping the Daily Flow title or accordion control."
      },
      {
        title: "Rescue as support status",
        detail:
          "Rescue moved out of the required daily checklist and into Support Status, where it can read Ready, Active, or Done without penalizing days when no urge needs rescuing."
      },
      {
        title: "Editable primary stake",
        detail:
          "The protected default reason is now My life, and it can be edited without becoming deletable. Clearing it restores the safe default."
      },
      {
        title: "Sobriety clock management",
        detail:
          "The main clock stays on Home, while add, show-on-Home, edit, reset, and delete controls now live under Recovery support in Settings."
      }
    ],
    smallerFixes: [
      "Emergency and support flows now use typed Shield actions instead of loose string matching.",
      "Per-base Shibit care state is preserved more consistently when switching avatars.",
      "Old Myself stake defaults migrate cleanly into the new My life primary stake reason.",
      "Guide sheets received clearer spacing, badges, and pagination for smaller screens.",
      "Action colors were separated so Feed, Restart, Shibit, Care, Rescue, Soothe, Meetings, Water, Medicine, Shield, Support, Reflect, Plan, Den, and Pause are easier to tell apart wherever they appear.",
      "The hold-to-pledge button now has a richer gradient treatment while preserving the same hold interaction.",
      "Release announcements can stay short in-app while linking here for the full detail list."
    ]
  },
  {
    id: "version-1-1",
    version: "Version 1.1",
    date: "September 12, 2026",
    title: "Mood, risks, themes, and timer alerts",
    intro:
      "Version 1.1 pulled together clearer Home language, richer Shibit care systems, refreshed Den guidance, stronger Pause timer alerts, and visual cleanup across themes and rooms.",
    highlights: [
      {
        title: "Mood and risks",
        detail:
          "The Den now has dedicated Mood and Risks guide pages, active risk badges, treatment badges, clearer untreated-effect copy, and a mood pill beside Shibit level."
      },
      {
        title: "Home and recovery flow",
        detail:
          "Home now uses clearer sobriety clock wording, improved recovery action colors, rotating stake reasons, compact risk chips, and a more direct Den shortcut."
      },
      {
        title: "Shibit stats and care",
        detail:
          "Stats now better explain your recovery buddy, the Shibit, including Health, Hunger, Hygiene, Home, Strength, Hope, Wisdom, Serenity, and Courage."
      },
      {
        title: "Themes and suites",
        detail:
          "Theme previews and suite rooms were tuned so color overlays feel present without flattening the artwork, especially on synthwave and suit suite rooms."
      },
      {
        title: "Pause timers",
        detail:
          "Timer completion now uses a stronger in-app alarm with haptics, while local notifications stay scheduled for background or locked-screen timer endings."
      },
      {
        title: "Shibit collection refresh",
        detail:
          "Several Shibit bases and looks were refreshed, renamed, or reorganized so the collection lines up better with the current pack direction."
      }
    ],
    smallerFixes: [
      "History and stake displays were tightened up for easier scanning.",
      "Settings copy now consistently refers to sobriety clocks instead of timers where appropriate.",
      "Game and care resource language now uses Courage and Serenity more consistently.",
      "The App Tour badge and dark-theme contrast received readability polish.",
      "Stats and guide sheets received spacing, pagination, and badge color refinements."
    ]
  }
];
---

<SiteLayout
  title="Pack Shield Release Log"
  description="See what changed in Pack Shield: Recovery Buddy releases, including Version 1.4 Essentials and Pause updates, Version 1.3 gratitude and meditation, Version 1.2 Shield and Daily Flow polish, and Version 1.1 timer alert updates."
>
  <main id="content" class="site-shell release-page">
    <section class="release-hero glass-panel" aria-labelledby="release-title">
      <p class="eyebrow">Release log</p>
      <h1 id="release-title">What changed in Pack Shield</h1>
      <p>
        A plain-language history of important app updates. In-app announcements link here when a release needs more detail than a small card can comfortably hold.
      </p>
    </section>

    <div class="release-list">
      {releases.map((release) => (
        <article class="release-entry glass-panel" id={release.id}>
          <div class="release-entry-header">
            <div>
              <p class="eyebrow">{release.date}</p>
              <h2>{release.title}</h2>
            </div>
            <a class="release-badge" href={`#${release.id}`} aria-label={`Permalink to ${release.version}`}>
              {release.version}
            </a>
          </div>

          <p class="release-intro">{release.intro}</p>

          <div class="release-summary-grid">
            {release.highlights.map((item) => (
              <section class="release-change-card">
                <h3>{item.title}</h3>
                <p>{item.detail}</p>
              </section>
            ))}
          </div>

          <section class="release-fixes" aria-labelledby={`${release.id}-fixes`}>
            <h3 id={`${release.id}-fixes`}>Also included</h3>
            <ul>
              {release.smallerFixes.map((fix) => <li>{fix}</li>)}
            </ul>
          </section>
        </article>
      ))}
    </div>
  </main>
</SiteLayout>
