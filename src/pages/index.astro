---
import SiteLayout from "../components/SiteLayout.astro";

const appStoreUrl = "https://apps.apple.com/app/id6809620104";
const appStoreBadgeUrl = "https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/en-us?size=250x83";

const heroScreenshots = {
  primary: {
    src: "/screenshots/home-dashboard.jpg",
    alt: "Pack Shield Today screen showing sober time, Just For Today actions, Rescue, Daily Routine, and bottom navigation."
  },
  secondary: {
    src: "/screenshots/pledge-saved.jpg",
    alt: "Pack Shield gratitude card with daily gratitude items, intention for the day, and a Shibit companion."
  },
  tertiary: {
    src: "/screenshots/the-den.jpg",
    alt: "The Den screen showing a recovery buddy room, buddy list, care stats, and care actions."
  }
};

const websiteScreenshots = [
  {
    title: "Today",
    label: "Start here",
    src: "/screenshots/home-dashboard.jpg",
    alt: "Pack Shield Today screen with sober time, recovery buddy, Rescue, pledge, and daily routine shortcuts.",
    description: "Sober time, what you are protecting, Rescue, pledge, and Daily Routine stay in one scannable place."
  },
  {
    title: "Gratitude Card",
    label: "Reflect",
    src: "/screenshots/pledge-saved.jpg",
    alt: "Pack Shield gratitude card with three gratitude items, intention for the day, and Shibit companion details.",
    description: "Gratitude cards turn a saved list into a shareable recovery snapshot with your intention, buddy, level, and current look."
  },
  {
    title: "The Den",
    label: "Companion",
    src: "/screenshots/the-den.jpg",
    alt: "The Den screen showing a recovery buddy room, buddy list, stats, wisdom points, and care actions.",
    description: "The Den keeps optional buddy care, stats, looks, rooms, and progress in one place when you want a deeper companion layer."
  },
  {
    title: "Shield",
    label: "Friction",
    src: "/screenshots/shield-plan.jpg",
    alt: "Shield tab explaining optional Screen Time protection, protected selections, active windows, pauses, and unlock rules.",
    description: "Optional Screen Time friction explains what is protected, when it runs, and how pauses or emergency unlocks work before you turn it on."
  },
  {
    title: "Rescue",
    label: "Help now",
    src: "/screenshots/support-people.jpg",
    alt: "Rescue screen with a Shibit companion, craving interruption steps, and a Start Rescue button.",
    description: "Rescue opens a short, structured interruption flow for risky moments, with breathing, delay, reasons, water, and protection prompts."
  },
  {
    title: "Pause Timers",
    label: "Ride it out",
    src: "/screenshots/galaxy-glide.jpg",
    alt: "Pause tab showing countdown pause ideas, timer alerts, and editable countdown timers.",
    description: "Countdown, repeat, and Pomodoro pauses help you create a little space before acting on an urge."
  },
  {
    title: "Progress",
    label: "Progress",
    src: "/screenshots/history.jpg",
    alt: "Progress screen with pledge cards, gratitude lists, buddy memories, and bottom navigation.",
    description: "Pledge cards, gratitude lists, buddy memories, calendars, badges, and history keep the focus on patterns instead of shame."
  }
];
---

<SiteLayout
  title="Pack Shield: Recovery Buddy"
  description="Pack Shield: Recovery Buddy helps adults track sober time, get help when urges hit, use Pause timers, and add optional friction around risky apps or sites."
  socialImage="/screenshots/home-dashboard.jpg"
  bodyClass="marketing-page"
  footerKind="marketing"
  stickyCta
>
  <main id="content" class="site-shell">
    <section class="hero" aria-labelledby="title">
      <div class="hero-copy">
        <div class="hero-kicker">
          <img src="/app-icon.png" alt="" width="46" height="46" />
          <div>
            <span>Pack Shield: Recovery Buddy for iPhone</span>
            <strong>Track sober time. Get help fast.</strong>
          </div>
        </div>
        <h1 id="title">Pack Shield: Recovery Buddy</h1>
        <p>
          Track sober time, remember what you are protecting, open Rescue when urges hit, and use Pause timers before the risky choice gets momentum. Daily Routine keeps Just For Today actions, reminders, meetings, and latest activity close, while All Tools can add deeper Shield, Games, support, buddy controls, and personalized recovery cards when you want them.
        </p>
        <div class="button-row">
          <a class="app-store-badge-link" href={appStoreUrl} aria-label="Download Pack Shield on the App Store">
            <img
              class="app-store-badge"
              src={appStoreBadgeUrl}
              alt="Download on the App Store"
              width="250"
              height="83"
            />
          </a>
          <a class="button secondary" href="#screenshots">Preview the app</a>
        </div>
        <p class="hero-note">For adults 18+. Pack Shield is a support tool, not medical treatment or crisis care.</p>
        <div class="stats" aria-label="Pack Shield highlights">
          <div class="stat">
            <strong>Clock</strong>
            <span>Sober time</span>
          </div>
          <div class="stat">
            <strong>Rescue</strong>
            <span>Help now</span>
          </div>
          <div class="stat">
            <strong>Pause</strong>
            <span>Ride it out</span>
          </div>
        </div>
      </div>
      <div class="hero-visual" aria-label="Pack Shield iPhone previews">
        <div class="phone-stack real-phone-stack">
          <article class="iphone-frame hero-phone primary-shot screenshot-device" aria-label="Pack Shield home screen preview">
            <div class="phone-button left"></div>
            <div class="phone-button right"></div>
            <img
              class="app-screenshot"
              src={heroScreenshots.primary.src}
              alt={heroScreenshots.primary.alt}
              width="736"
              height="1600"
              decoding="async"
              fetchpriority="high"
            />
          </article>
          <article class="iphone-frame hero-phone secondary-shot screenshot-device" aria-label="Pack Shield pledge card preview">
            <img
              class="app-screenshot"
              src={heroScreenshots.secondary.src}
              alt={heroScreenshots.secondary.alt}
              width="736"
              height="1600"
              loading="lazy"
              decoding="async"
            />
          </article>
          <article class="iphone-frame hero-phone tertiary-shot screenshot-device" aria-label="Pack Shield Den preview">
            <img
              class="app-screenshot"
              src={heroScreenshots.tertiary.src}
              alt={heroScreenshots.tertiary.alt}
              width="736"
              height="1600"
              loading="lazy"
              decoding="async"
            />
          </article>
        </div>
      </div>
    </section>

    <section class="section proof-band" aria-labelledby="proof-title">
      <div>
        <p class="eyebrow">Why it exists</p>
        <h2 id="proof-title">Track sober time, then protect the next choice.</h2>
      </div>
      <p>
        Pack Shield: Recovery Buddy is for people cutting back, quitting, rebuilding trust with themselves, or protecting an early streak. Essentials keeps the app focused on the next helpful action; All Tools adds deeper control when you want it.
      </p>
    </section>

    <section class="section screenshots-section" id="screenshots" aria-labelledby="screenshots-title">
      <p class="eyebrow">iPhone experience</p>
      <h2 id="screenshots-title">Screens that stay close to the moment.</h2>
      <p class="section-lead">
        Preview the core flows before you download: sober time, Rescue, Pause, Daily Routine, gratitude cards, your recovery buddy, optional Shield setup, and progress history.
      </p>
      <div class="screenshot-grid product-shot-grid">
        {websiteScreenshots.map((shot) => (
          <article class="product-shot">
            <div class="shot-copy">
              <span>{shot.label}</span>
              <h3>{shot.title}</h3>
              <p>{shot.description}</p>
            </div>
            <div class="iphone-frame screenshot-shot screenshot-device" aria-label={`${shot.title} screenshot preview`}>
              <img
                class="app-screenshot"
                src={shot.src}
                alt={shot.alt}
                width="736"
                height="1600"
                loading="lazy"
                decoding="async"
              />
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="features-title">
      <h2 id="features-title">Essentials first. More tools when useful.</h2>
      <p class="section-lead">
        Pack Shield: Recovery Buddy starts calm, then lets you reveal deeper controls when support, planning, or Screen Time friction would help.
      </p>
      <div class="feature-grid">
        <article class="feature-card">
          <span class="feature-index">01</span>
          <h3>Sober time you can see</h3>
          <p>Keep one or more clear clocks for the substance or behavior you are changing, with remembered day, hour, month, and year views.</p>
        </article>
        <article class="feature-card">
          <span class="feature-index">02</span>
          <h3>Rescue, Pause, and Routine</h3>
          <p>Name the moment, start a short timer, choose a Just For Today action, or keep reminders and meetings visible without extra setup.</p>
        </article>
        <article class="feature-card">
          <span class="feature-index">03</span>
          <h3>All Tools when useful</h3>
          <p>All Tools keeps sortable recovery actions, Shield tuning, meetings, recovery planning, buddy care, games, and data controls available.</p>
        </article>
      </div>
    </section>

    <section class="section" aria-labelledby="actions-title">
      <p class="eyebrow">In the app</p>
      <h2 id="actions-title">Helpful actions stay close.</h2>
      <p class="section-lead">
        Today keeps high-value actions close, so support is visible before the risky choice gets momentum.
      </p>
      <div class="action-grid">
        <article class="action-tile tone-rescue">
          <span class="action-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M3 13h4l2-6 4 12 3-8 2 2h3"></path></svg>
          </span>
          <div><h3>Rescue</h3><p>Open the urge interruption flow.</p></div>
        </article>
        <article class="action-tile tone-restart">
          <span class="action-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="7"></circle><circle cx="12" cy="12" r="3"></circle><path d="M7 7l3 3M14 14l3 3M17 7l-3 3M10 14l-3 3"></path></svg>
          </span>
          <div><h3>Restart</h3><p>Use the guided reset after a slip.</p></div>
        </article>
        <article class="action-tile tone-talk">
          <span class="action-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M6 15l-3 3V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H6z"></path><path d="M10 18h7l4 3V10"></path></svg>
          </span>
          <div><h3>Talk</h3><p>Start a Shibit check-in.</p></div>
        </article>
        <article class="action-tile tone-focus">
          <span class="action-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M10 3h4M12 8v5l3 2"></path><circle cx="12" cy="14" r="7"></circle></svg>
          </span>
          <div><h3>Pause</h3><p>Run countdowns, repeat nudges, or Pomodoro blocks.</p></div>
        </article>
        <article class="action-tile tone-plan">
          <span class="action-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M8 4h8l1 3H7l1-3z"></path><path d="M7 6H5v15h14V6h-2"></path><path d="M8 11h8M8 15h8M8 19h5"></path></svg>
          </span>
          <div><h3>Plan</h3><p>Open coping steps and recovery plan.</p></div>
        </article>
        <article class="action-tile tone-meetings">
          <span class="action-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 7h11a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H4V7z"></path><path d="M17 10l4-2v8l-4-2"></path></svg>
          </span>
          <div><h3>Meetings</h3><p>Find support meetings quickly.</p></div>
        </article>
        <article class="action-tile tone-games">
          <span class="action-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M7 9h10a4 4 0 0 1 4 4v2a3 3 0 0 1-5 2l-1.5-1h-5L8 17a3 3 0 0 1-5-2v-2a4 4 0 0 1 4-4z"></path><path d="M8 12v4M6 14h4M16.5 13h.01M18.5 15h.01"></path></svg>
          </span>
          <div><h3>Games</h3><p>Open short games from one sheet.</p></div>
        </article>
        <article class="action-tile tone-shield">
          <span class="action-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6l7-3z"></path></svg>
          </span>
          <div><h3>Shield</h3><p>Add friction to risky paths.</p></div>
        </article>
        <article class="action-tile tone-review">
          <span class="action-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M17 3a8 8 0 1 0 4 13 7 7 0 0 1-8-8 7 7 0 0 1 4-5z"></path><path d="M5 5l1-2 1 2 2 1-2 1-1 2-1-2-2-1 2-1z"></path></svg>
          </span>
          <div><h3>Review</h3><p>Close the loop while the day is fresh.</p></div>
        </article>
        <article class="action-tile tone-reasons">
          <span class="action-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 4h10a4 4 0 0 1 4 4v12H8a3 3 0 0 0-3 3V4z"></path><path d="M8 8h7M8 12h7M8 16h5"></path></svg>
          </span>
          <div><h3>Reasons</h3><p>Stay close to why you started.</p></div>
        </article>
        <article class="action-tile tone-room">
          <span class="action-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 7h12v10H4z"></path><path d="M16 10l4-2v11H8"></path><path d="M7 4l1 2 2 1-2 1-1 2-1-2-2-1 2-1 1-2z"></path></svg>
          </span>
          <div><h3>The Den</h3><p>Open buddy care, games, looks, and rooms.</p></div>
        </article>
      </div>
    </section>

    <section class="section final-cta" id="support" aria-labelledby="support-title">
      <div>
        <p class="eyebrow">Ready when you are</p>
        <h2 id="support-title">Track sober time. Protect the next choice.</h2>
        <p>
          Download Pack Shield: Recovery Buddy, then start with the substance or behavior you are changing.
        </p>
      </div>
      <div class="final-actions">
        <a class="app-store-badge-link" href={appStoreUrl} aria-label="Download Pack Shield: Recovery Buddy on the App Store">
          <img
            class="app-store-badge"
            src={appStoreBadgeUrl}
            alt="Download on the App Store"
            width="250"
            height="83"
          />
        </a>
        <a class="button secondary" href="mailto:support@packshield.app">support@packshield.app</a>
      </div>
    </section>
  </main>
</SiteLayout>
