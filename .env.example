APP_API_KEY=replace-with-a-long-random-api-key
APP_SIGNING_SECRET=replace-with-a-long-random-signing-secret
PIN_PEPPER=replace-with-a-long-random-pin-pepper
PACKPACT_PUBLIC_BASE_URL=https://packshield.app
PACKPACT_SMS_ENABLED=false

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567
TWILIO_VALIDATE_WEBHOOKS=true

REDIS_URL=redis://default:replace-with-password@replace-with-host:6379

# Optional Upstash REST fallback if you choose Upstash instead of Vercel Redis.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-token
